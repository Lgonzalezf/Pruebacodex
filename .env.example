# URL completa de conexión a la base de datos Neon/PostgreSQL.
# Formato: postgresql+psycopg2://usuario:password@host:puerto/base_de_datos
DATABASE_URL=postgresql+psycopg2://usuario:password@ep-neon-host/neondb

# Esquema opcional donde se crearán las tablas (por defecto "public").
#DATABASE_SCHEMA=public
